@@ -50,0 +52,19 @@
+
+func submit_visual(side: String, joints: PackedVector3Array, confidence: PackedFloat32Array, remaining_seconds: float, opacity: float = 1.0) -> void:
+	if side not in ["left","right"] or joints.size()!=26 or confidence.size()!=26: return
+	if not is_finite(remaining_seconds) or remaining_seconds<=0 or remaining_seconds>.220: return
+	if not is_finite(opacity) or opacity<0 or opacity>1: return
+	for point in joints:
+		if not point.is_finite(): return
+	for value in confidence:
+		if not is_finite(value) or value<0 or value>1: return
+	visual_frames[side]={"joints":joints,"confidence":confidence,"until":Time.get_ticks_usec()*1e-6+remaining_seconds,"opacity":opacity}
+
+func visual_grace_for(hand: String) -> bool:
+	var now:=Time.get_ticks_usec()*1e-6
+	for side in (["left","right"] if hand=="both" else [hand]):
+		if not ready_for(side) and (not visual_frames.has(side) or now>=visual_frames[side].until):return false
+	return true
+
+func clear_visual(side: String) -> void:
+	visual_frames.erase(side)
