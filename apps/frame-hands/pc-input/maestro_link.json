{
  "name": "Frame Hands (Steam Link hand type) for Maestro",
  "controller_type": "svl_hand_interaction_augmented",
  "last_edited_by": "UnrealEngine",
  "bindings": {
    "/actions/main": {
      "sources": [
        {
          "inputs": {
            "click": {
              "output": "/actions/main/in/JJHMD_Left_Trigger"
            }
          },
          "mode": "trigger",
          "path": "/user/hand/left/input/index_pinch",
          "parameters": {
            "click_activate_threshold": "0.65",
            "click_deactivate_threshold": "0.45"
          }
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/main/in/JJHMD_Left_Grip"
            }
          },
          "mode": "trigger",
          "path": "/user/hand/left/input/grip",
          "parameters": {
            "click_activate_threshold": "0.65",
            "click_deactivate_threshold": "0.45"
          }
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/main/in/JJHMD_Right_Trigger"
            }
          },
          "mode": "trigger",
          "path": "/user/hand/right/input/index_pinch",
          "parameters": {
            "click_activate_threshold": "0.65",
            "click_deactivate_threshold": "0.45"
          }
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/main/in/JJHMD_Right_Grip"
            }
          },
          "mode": "trigger",
          "path": "/user/hand/right/input/grip",
          "parameters": {
            "click_activate_threshold": "0.65",
            "click_deactivate_threshold": "0.45"
          }
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/main/in/PauseMenu"
            }
          },
          "mode": "button",
          "path": "/user/hand/left/input/system"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/main/in/JJHMD_Right_System"
            }
          },
          "mode": "button",
          "path": "/user/hand/right/input/system"
        }
      ],
      "poses": [
        {
          "output": "/actions/main/in/controllerleft",
          "path": "/user/hand/left/pose/raw",
          "requirement": "optional"
        },
        {
          "output": "/actions/main/in/controllerright",
          "path": "/user/hand/right/pose/raw"
        }
      ],
      "skeleton": [
        {
          "output": "/actions/main/in/skeletonleft",
          "path": "/user/hand/left/input/skeleton/left"
        },
        {
          "output": "/actions/main/in/skeletonright",
          "path": "/user/hand/right/input/skeleton/right"
        }
      ],
      "haptics": [
        {
          "output": "/actions/main/out/vibrateleft",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/main/out/vibrateright",
          "path": "/user/hand/right/output/haptic"
        }
      ]
    }
  },
  "description": "Index pinch = trigger, fist = grip, skeleton + raw poses; hand-tracking identity",
  "app_key": "steam.app.2701700"
}