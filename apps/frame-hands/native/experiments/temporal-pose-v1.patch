diff --git a/apps/frame-hands/native/rig_temporal_prior.h b/apps/frame-hands/native/rig_temporal_prior.h
new file mode 100644
--- /dev/null
+++ b/apps/frame-hands/native/rig_temporal_prior.h
@@ -0,0 +1,28 @@
+#pragma once
+#include "fit_hand_rig.h"
+namespace fhn {
+// Isolated fitting experiment. Preference for recent orientation/articulation,
+// not a visibility, collision, velocity or gesture-confidence estimate.
+struct RigTemporalPrior {
+    RigPose reference{};
+    double sigma_radians=.35,huber=3.;
+    using Residual=std::array<double,23>;
+    void validate(const HandRig& rig,int side)const {
+        if(reference.side!=side||!std::isfinite(sigma_radians)||sigma_radians<.001||!std::isfinite(huber)||huber<=0)
+            throw std::invalid_argument("Invalid temporal pose prior");
+        rig.landmarks(reference.angles,reference.wrist,side);
+    }
+    Residual residual(const RigPose& pose)const {
+        Q d=(pose.wrist.q*reference.wrist.q.inv()).unit();
+        if(d.w<0)d={-d.w,-d.x,-d.y,-d.z}; // Antipodal quaternions represent one rotation.
+        double n=std::sqrt(d.x*d.x+d.y*d.y+d.z*d.z);
+        double scale=n>1e-12?2*std::atan2(n,d.w)/n:2.;
+        Residual r{};r[0]=d.x*scale/sigma_radians;r[1]=d.y*scale/sigma_radians;r[2]=d.z*scale/sigma_radians;
+        for(int j=0;j<20;++j)r[j+3]=(pose.angles[j]-reference.angles[j])/sigma_radians;
+        return r;
+    }
+    static double dot(const Residual& a,const Residual& b){double n=0;for(int j=0;j<23;++j)n+=a[j]*b[j];return n;}
+    double cost(const RigPose& p)const {auto r=residual(p);double n=std::sqrt(dot(r,r));return n<=huber?.5*n*n:huber*(n-.5*huber);}
+    double weight(const Residual& r)const{double n=std::sqrt(dot(r,r));return n>huber?huber/n:1.;}
+};
+}
