+#include "fit_palm_root.h"
+#include "whole_pose_seed.h"
+#include <fstream>
+#include <iomanip>
+#include <iostream>
+#include <random>
+int main(int argc,char**argv){try{
+ if(argc!=5)return 2;std::ifstream l(argv[1]),r(argv[2]),c(argv[3]);if(std::ifstream(argv[4]).good())return 3;
+ std::array<fhn::HandRig,2> rigs{fhn::HandRig::load(l),fhn::HandRig::load(r)};auto cameras=fhn::load_rig_cameras(c);std::ofstream out(argv[4]);out<<std::setprecision(17);
+ std::mt19937 random(100517);std::normal_distribution<double> noise(0,1);int cases=0,checks=0;
+ auto check=[&](bool value){if(!value)throw std::runtime_error("Palm control failed");++checks;};
+ for(int side=0;side<2;++side)for(int gesture=0;gesture<4;++gesture)for(int rotation=0;rotation<3;++rotation)for(int mode=0;mode<4;++mode){
+  const auto& rig=rigs[side];fhn::RigPose truth;truth.side=side;truth.wrist={fhn::rig_exp({.3*rotation,.2*rotation,-.4*rotation}),{side?70.:-70.,15.,-450.}};
+  for(int j=0;j<20;++j){double fraction=gesture==0?.15:.8;if((gesture==2||gesture==3)&&j/4==1)fraction=.15;if(gesture==3&&j/4==2)fraction=.15;truth.angles[j]=(1-fraction)*rig.joints[j].lower+fraction*rig.joints[j].upper;}
+  auto points=rig.landmarks(truth.angles,truth.wrist,side);std::array<fhn::PixelObservation,21> obs{};
+  for(int i=0;i<20;++i)for(int v=0;v<2;++v){check(cameras[v].project(points[i],obs[i].point[v]));obs[i].present[v]=true;
+   bool palm=i==5||i==8||i==11||i==14||i==17;
+   if(mode==3||(mode==1&&palm)){obs[i].point[v].x+=2*noise(random);obs[i].point[v].y+=2*noise(random);}
+   if(mode==2&&!palm){obs[i].point[v].x+=20;obs[i].point[v].y-=15;}
+  }
+  auto seed=truth;seed.wrist.t=seed.wrist.t+fhn::V{6,-4,8};seed.wrist.q=(fhn::rig_exp({.08,-.12,.07})*seed.wrist.q).unit();
+  auto root=fhn::fit_palm_root(rig,seed,cameras,obs);check(root.sufficient&&root.cost<=root.initial_cost&&root.pose.angles==seed.angles);
+  auto articulated=fhn::fit_rig_pixels(rig,root.pose,cameras,obs,{},0,&seed.angles,false,fhn::PixelFitDofs::AnglesOnly);
+  check(articulated.pose.wrist.q.w==root.pose.wrist.q.w&&articulated.pose.wrist.q.x==root.pose.wrist.q.x&&articulated.pose.wrist.q.y==root.pose.wrist.q.y&&articulated.pose.wrist.q.z==root.pose.wrist.q.z&&(articulated.pose.wrist.t-root.pose.wrist.t).len()==0);
+  auto control=fhn::fit_rig_pixels(rig,seed,cameras,obs);out<<side<<' '<<gesture<<' '<<rotation<<' '<<mode;
+  for(const auto* fit:std::array<const fhn::PixelFitResult*,2>{&control,&articulated}){auto fitted=rig.landmarks(fit->pose.angles,fit->pose.wrist,side);double error=0;for(int i=0;i<21;++i){auto e=fitted[i]-points[i];error+=e.dot(e);}auto q=(fit->pose.wrist.q*truth.wrist.q.inv()).unit();double degrees=2*std::acos(std::clamp(std::abs(q.w),0.,1.))*180/3.141592653589793;
+   out<<' '<<(fit->pose.wrist.t-truth.wrist.t).len()<<' '<<degrees<<' '<<std::sqrt(error/21);
+  }
+  out<<'\n';
+  if(mode==0||mode==2){check((root.pose.wrist.t-truth.wrist.t).len()<1e-4);auto q=(root.pose.wrist.q*truth.wrist.q.inv()).unit();check(std::abs(q.w)>1-1e-10);}
+  obs[5].present[1]=false;check(!fhn::fit_palm_root(rig,seed,cameras,obs).sufficient);++cases;
+ }
+ if(!out.good())return 5;std::cout<<"cases="<<cases<<" checks="<<checks<<" failures=0\n";return 0;
+}catch(const std::exception&e){std::cerr<<e.what()<<'\n';return 1;}}
