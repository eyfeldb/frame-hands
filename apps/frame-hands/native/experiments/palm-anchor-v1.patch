diff --git a/apps/frame-hands/native/fit_palm_root.h b/apps/frame-hands/native/fit_palm_root.h
new file mode 100644
--- /dev/null
+++ b/apps/frame-hands/native/fit_palm_root.h
@@ -0,0 +1,12 @@
+#pragma once
+#include "fit_rig_pixels.h"
+namespace fhn {
+// Isolated current-stereo root estimate. No temporal hold or input confidence.
+inline PixelFitResult fit_palm_root(const HandRig& rig,const RigPose& seed,
+    const std::array<RigCamera,2>& cameras,const std::array<PixelObservation,21>& observations){
+    for(const auto& o:observations)o.validate();std::array<PixelObservation,21> palm{};
+    for(int i:{5,8,11,14,17})palm[i]=observations[i];
+    RigFitOptions options;options.iterations=20;options.angle_prior=0;
+    return fit_rig_pixels(rig,seed,cameras,palm,options,0,nullptr,false,PixelFitDofs::WristOnly);
+}
+}
