+#include "fit_palm_root.h"
+#include "rig_fit_quality.h"
+#include <chrono>
+#include <fstream>
+#include <iostream>
+#include <iomanip>
+int main(int argc,char**argv){try{
+ if(argc!=6)return 2;std::ifstream l(argv[1]),r(argv[2]),c(argv[3]),input(argv[4]);if(std::ifstream(argv[5]).good())return 3;
+ std::array<fhn::HandRig,2> rigs{fhn::HandRig::load(l),fhn::HandRig::load(r)};auto cameras=fhn::load_rig_cameras(c);std::ofstream out(argv[5]);out<<std::setprecision(17);fhn::RigPose seed;int count=0;
+ while(input>>seed.side){if(seed.side<0||seed.side>1)return 4;
+  if(!(input>>seed.wrist.q.w>>seed.wrist.q.x>>seed.wrist.q.y>>seed.wrist.q.z>>seed.wrist.t.x>>seed.wrist.t.y>>seed.wrist.t.z))return 4;
+  for(auto& x:seed.angles)if(!(input>>x))return 4;std::array<fhn::PixelObservation,21> obs{};
+  for(auto& o:obs)for(int v=0;v<2;++v){int present;if(!(input>>present>>o.point[v].x>>o.point[v].y>>o.sigma[v])||present<0||present>1)return 4;o.present[v]=present;}
+  const auto& rig=rigs[seed.side];auto t0=std::chrono::steady_clock::now();auto root=fhn::fit_palm_root(rig,seed,cameras,obs);auto t1=std::chrono::steady_clock::now();
+  if(!root.sufficient||root.pose.angles!=seed.angles||root.cost>root.initial_cost)throw std::runtime_error("Root contract failed");
+  auto anchored=fhn::fit_rig_pixels(rig,root.pose,cameras,obs,{},0,&seed.angles,false,fhn::PixelFitDofs::AnglesOnly);auto t2=std::chrono::steady_clock::now();
+  auto continued=fhn::fit_rig_pixels(rig,seed,cameras,obs);auto t3=std::chrono::steady_clock::now();
+  if(anchored.pose.wrist.q.w!=root.pose.wrist.q.w||anchored.pose.wrist.q.x!=root.pose.wrist.q.x||anchored.pose.wrist.q.y!=root.pose.wrist.q.y||anchored.pose.wrist.q.z!=root.pose.wrist.q.z||(anchored.pose.wrist.t-root.pose.wrist.t).len()!=0)throw std::runtime_error("Frozen root changed");
+  auto us=[](auto a,auto b){return std::chrono::duration<double,std::micro>(b-a).count();};out<<count<<' '<<us(t0,t1)<<' '<<us(t1,t2)<<' '<<us(t2,t3)<<' '<<root.initial_cost<<' '<<root.cost;
+  for(const auto* p:std::array<const fhn::RigPose*,3>{&seed,&continued.pose,&anchored.pose}){auto quality=fhn::rig_fit_quality(rig,*p,cameras,obs);if(!quality.projectable)throw std::runtime_error("Behind camera");
+   out<<' '<<quality.all.rmse_px()<<' '<<quality.palm.rmse_px()<<' '<<quality.fingers.rmse_px()<<' '<<p->wrist.q.w<<' '<<p->wrist.q.x<<' '<<p->wrist.q.y<<' '<<p->wrist.q.z<<' '<<p->wrist.t.x<<' '<<p->wrist.t.y<<' '<<p->wrist.t.z;
+   for(double angle:p->angles)out<<' '<<angle;for(const auto& point:rig.landmarks(p->angles,p->wrist,p->side))out<<' '<<point.x<<' '<<point.y<<' '<<point.z;
+  }
+  out<<'\n';++count;
+ }
+ if(!count||!input.eof()||!out.good())return 5;std::cout<<"palm_poses="<<count<<'\n';return 0;
+}catch(const std::exception&e){std::cerr<<e.what()<<'\n';return 1;}}
